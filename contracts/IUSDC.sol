pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

/// @notice ERC-20 extended with EIP-3009 signed-transfer functions used by USDC on Avalanche.
interface IUSDC is IERC20 {
    /// @notice Buyer-initiated transfer; signed by `from`.
    function transferWithAuthorization(
        address from,
        address to,
        uint256 value,
        uint256 validAfter,
        uint256 validBefore,
        bytes32 nonce,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external;

    /// @notice Recipient-initiated transfer; `msg.sender` must equal `to`.
    ///         Used by TaskEscrow to prevent front-running.
    function receiveWithAuthorization(
        address from,
        address to,
        uint256 value,
        uint256 validAfter,
        uint256 validBefore,
        bytes32 nonce,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external;
}

